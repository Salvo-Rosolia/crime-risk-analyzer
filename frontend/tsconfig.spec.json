/* To learn more about Typescript configuration file: https://www.typescriptlang.org/docs/handbook/tsconfig-json.html. */
/* To learn more about Angular compiler options: https://angular.dev/reference/configs/angular-compiler-options. */
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "./out-tsc/spec",
    // `node`: some specs read the sources from disk (fs, path, __dirname).
    "types": ["jest", "node"],
    // Tests only: async/await must be downleveled (ES2016) because zone.js does not track the native one;
    // the production bundle is already downleveled by the Angular build. `lib` keeps the ES2022 APIs.
    // With the ES2022 target a mock that rejects a promise inside a DOM event was reported
    // as unhandled (false positive) and made a later test blow up (#383).
    "target": "ES2016",
    "lib": ["ES2022", "DOM", "DOM.Iterable"]
  },
  "include": ["src/**/*.d.ts", "src/**/*.spec.ts"]
}
